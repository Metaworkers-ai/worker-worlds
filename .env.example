# Safe loopback-only Worker Worlds development configuration.
# Copy this file to .env; never commit .env or a real provider credential.
WORKER_WORLDS_DATABASE_URL=postgresql://worker_worlds:worker_worlds_local@127.0.0.1:55432/worker_worlds_dev
WORKER_WORLDS_TEST_DATABASE_URL=postgresql://worker_worlds:worker_worlds_local@127.0.0.1:55432/worker_worlds_dev
WORKER_WORLDS_ARTIFACT_DIR=.worker-worlds/api
WORKER_WORLDS_API_HOST=127.0.0.1
WORKER_WORLDS_API_PORT=8000
WORKER_WORLDS_DASHBOARD_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required only for explicitly authorized OpenAI or LangGraph evaluations.
OPENAI_API_KEY=

        "$ref": "#/$defs/JsonValue"
      },
      "title": "Configuration",
      "type": "object"
    },
    "domain_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
      "title": "Domain Id",
      "type": "string"
    },
    "request_key": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Request Key",
      "type": "string"
    },
    "role_id": {

{
  "$defs": {
    "ComparisonClassification": {
      "description": "Primary semantic classification for a scenario comparison.",
      "enum": [
        "new_failure",
        "fixed",
        "unchanged_pass",
        "unchanged_failure",
        "failure_mode_changed",
        "flakiness_increased",
        "flakiness_decreased",
        "performance_regressed",
        "cost_regressed",
        "infrastructure_health_regressed",
        "insufficient_evidence",
        "incompatible"
      ],
      "title": "ComparisonClassification",
      "type": "string"
    },
    "CompatibilityLevel": {
      "description": "Compatibility classification for two immutable suite artifacts.",
      "enum": [
        "compatible",
        "compatible_with_warning",
        "incompatible"
      ],
      "title": "CompatibilityLevel",
      "type": "string"
    },
    "DistributionSummary": {
      "additionalProperties": false,
      "description": "Small-sample-aware deterministic distribution summary.",
      "properties": {
        "completed": {
          "title": "Completed",
          "type": "integer"
        },
        "cost_minor_total": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Minor Total"
        },
        "duration_p50_ms": {
          "title": "Duration P50 Ms",
          "type": "number"
        },
        "duration_p95_ms": {
          "title": "Duration P95 Ms",
          "type": "number"
        },
        "errors": {
          "title": "Errors",
          "type": "integer"
        },
        "failed": {
          "title": "Failed",
          "type": "integer"
        },
        "infrastructure_error_rate": {
          "default": 0,
          "title": "Infrastructure Error Rate",
          "type": "number"
        },
        "low_sample": {
          "title": "Low Sample",
          "type": "boolean"
        },
        "mutation_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Mutation Counts",
          "type": "object"
        },
        "outcome_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Outcome Counts",
          "type": "object"
        },
        "pass_rate": {
          "title": "Pass Rate",
          "type": "number"
        },
        "passed": {
          "title": "Passed",
          "type": "integer"
        },
        "requested": {
          "title": "Requested",
          "type": "integer"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "severity_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Severity Counts",
          "type": "object"
        },
        "terminal_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Terminal Counts",
          "type": "object"
        },
        "tokens_total": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens Total"
        },
        "tool_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Tool Counts",
          "type": "object"
        },
        "variability": {
          "title": "Variability",
          "type": "number"
        },
        "wilson_high": {
          "title": "Wilson High",
          "type": "number"
        },
        "wilson_low": {
          "title": "Wilson Low",
          "type": "number"
        }
      },
      "required": [
        "requested",
        "completed",
        "passed",
        "failed",
        "errors",
        "pass_rate",
        "wilson_low",
        "wilson_high",
        "variability",
        "low_sample",
        "outcome_counts",
        "severity_counts",
        "terminal_counts",
        "tool_counts",
        "mutation_counts",
        "duration_p50_ms",
        "duration_p95_ms"
      ],
      "title": "DistributionSummary",
      "type": "object"
    },
    "EvidenceKind": {
      "description": "Kinds of bounded evidence references.",
      "enum": [
        "initial_snapshot",
        "final_snapshot",
        "event",
        "tool_call",
        "worker_turn",
        "authorization",
        "changed_entity",
        "resource",
        "policy"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "description": "Resolvable bounded reference into RunRecord evidence.",
      "properties": {
        "facts": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Facts",
          "type": "object"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "reference": {
          "title": "Reference",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sequence"
        },
        "value": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        }
      },
      "required": [
        "kind",
        "reference"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "FailureModeDelta": {
      "additionalProperties": false,
      "description": "Semantic failure change with representative evidence links.",
      "properties": {
        "baseline_rate": {
          "default": 0,
          "title": "Baseline Rate",
          "type": "number"
        },
        "baseline_run_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Baseline Run Ids",
          "type": "array"
        },
        "candidate_rate": {
          "default": 0,
          "title": "Candidate Rate",
          "type": "number"
        },
        "candidate_run_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Candidate Run Ids",
          "type": "array"
        },
        "change": {
          "title": "Change",
          "type": "string"
        },
        "event_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Event Ids",
          "type": "array"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "identity": {
          "title": "Identity",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "outcome_signatures": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Outcome Signatures",
          "type": "array"
        },
        "representative_evidence": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Representative Evidence",
          "type": "object"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "severity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity"
        },
        "verdict_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Verdict Ids",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "identity",
        "change"
      ],
      "title": "FailureModeDelta",
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "description": "Distribution comparison for one scenario with one primary finding.",
  "properties": {
    "baseline": {
      "$ref": "#/$defs/DistributionSummary"
    },
    "baseline_run_ids": {
      "items": {
        "type": "string"
      },
      "title": "Baseline Run Ids",
      "type": "array"
    },
    "candidate": {
      "$ref": "#/$defs/DistributionSummary"
    },
    "candidate_run_ids": {
      "items": {
        "type": "string"
      },
      "title": "Candidate Run Ids",
      "type": "array"
    },
    "compatibility": {
      "$ref": "#/$defs/CompatibilityLevel"
    },
    "compatibility_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Compatibility Reasons",
      "type": "array"
    },
    "failure_deltas": {
      "items": {
        "$ref": "#/$defs/FailureModeDelta"
      },
      "title": "Failure Deltas",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/ComparisonClassification"
      },
      "title": "Findings",
      "type": "array"
    },
    "flakiness_delta": {
      "title": "Flakiness Delta",
      "type": "number"
    },
    "pass_rate_delta": {
      "title": "Pass Rate Delta",
      "type": "number"
    },
    "primary_classification": {
      "$ref": "#/$defs/ComparisonClassification"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tags": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    }
  },
  "required": [
    "scenario_id",
    "compatibility",
    "compatibility_reasons",
    "primary_classification",
    "findings",
    "baseline",
    "candidate",
    "pass_rate_delta",
    "flakiness_delta",
    "failure_deltas",
    "baseline_run_ids",
    "candidate_run_ids"
  ],
  "title": "ScenarioComparison",
  "type": "object"
}

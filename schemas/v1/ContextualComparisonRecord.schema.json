{
  "$defs": {
    "ComparisonClassification": {
      "description": "Primary semantic classification for a scenario comparison.",
      "enum": [
        "new_failure",
        "fixed",
        "unchanged_pass",
        "unchanged_failure",
        "failure_mode_changed",
        "flakiness_increased",
        "flakiness_decreased",
        "performance_regressed",
        "cost_regressed",
        "infrastructure_health_regressed",
        "insufficient_evidence",
        "incompatible"
      ],
      "title": "ComparisonClassification",
      "type": "string"
    },
    "ComparisonConfig": {
      "additionalProperties": false,
      "description": "Strict deterministic regression-gate configuration.",
      "properties": {
        "allow_scenario_hash_mismatch": {
          "default": false,
          "title": "Allow Scenario Hash Mismatch",
          "type": "boolean"
        },
        "critical_occurrences_allowed": {
          "default": 0,
          "minimum": 0,
          "title": "Critical Occurrences Allowed",
          "type": "integer"
        },
        "excluded_informational_metrics": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Excluded Informational Metrics",
          "type": "array"
        },
        "insufficient_samples": {
          "default": "warning",
          "pattern": "^(warning|fail)$",
          "title": "Insufficient Samples",
          "type": "string"
        },
        "maximum_cost_increase": {
          "default": 1.0,
          "minimum": 0,
          "title": "Maximum Cost Increase",
          "type": "number"
        },
        "maximum_flakiness_increase": {
          "default": 0.1,
          "minimum": 0,
          "title": "Maximum Flakiness Increase",
          "type": "number"
        },
        "maximum_infrastructure_error_rate": {
          "default": 0.01,
          "maximum": 1,
          "minimum": 0,
          "title": "Maximum Infrastructure Error Rate",
          "type": "number"
        },
        "maximum_p50_latency_increase": {
          "default": 1.0,
          "minimum": 0,
          "title": "Maximum P50 Latency Increase",
          "type": "number"
        },
        "maximum_p95_latency_increase": {
          "default": 1.0,
          "minimum": 0,
          "title": "Maximum P95 Latency Increase",
          "type": "number"
        },
        "maximum_pass_rate_decrease": {
          "default": 0.02,
          "maximum": 1,
          "minimum": 0,
          "title": "Maximum Pass Rate Decrease",
          "type": "number"
        },
        "maximum_token_increase": {
          "default": 1.0,
          "minimum": 0,
          "title": "Maximum Token Increase",
          "type": "number"
        },
        "minimum_candidate_pass_rate": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Candidate Pass Rate",
          "type": "number"
        },
        "new_high_failures_allowed": {
          "default": 0,
          "minimum": 0,
          "title": "New High Failures Allowed",
          "type": "integer"
        },
        "practical_significance": {
          "default": 0.02,
          "maximum": 1,
          "minimum": 0,
          "title": "Practical Significance",
          "type": "number"
        },
        "required_minimum_repetitions": {
          "default": 5,
          "exclusiveMinimum": 0,
          "title": "Required Minimum Repetitions",
          "type": "integer"
        },
        "scenario_overrides": {
          "additionalProperties": {
            "additionalProperties": {
              "$ref": "#/$defs/ComparisonOverrideValue"
            },
            "type": "object"
          },
          "title": "Scenario Overrides",
          "type": "object"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tag_overrides": {
          "additionalProperties": {
            "additionalProperties": {
              "$ref": "#/$defs/ComparisonOverrideValue"
            },
            "type": "object"
          },
          "title": "Tag Overrides",
          "type": "object"
        }
      },
      "title": "ComparisonConfig",
      "type": "object"
    },
    "ComparisonOverrideValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ]
    },
    "ComparisonReport": {
      "additionalProperties": false,
      "description": "Complete immutable behavioral comparison artifact.",
      "properties": {
        "baseline_hash": {
          "title": "Baseline Hash",
          "type": "string"
        },
        "baseline_name": {
          "title": "Baseline Name",
          "type": "string"
        },
        "baseline_source": {
          "title": "Baseline Source",
          "type": "string"
        },
        "candidate_hash": {
          "title": "Candidate Hash",
          "type": "string"
        },
        "candidate_source": {
          "title": "Candidate Source",
          "type": "string"
        },
        "compatibility": {
          "$ref": "#/$defs/CompatibilityLevel"
        },
        "compatibility_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Compatibility Reasons",
          "type": "array"
        },
        "config": {
          "$ref": "#/$defs/ComparisonConfig"
        },
        "created_at": {
          "description": "Timezone-aware UTC timestamp",
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "reproduction_commands": {
          "items": {
            "type": "string"
          },
          "title": "Reproduction Commands",
          "type": "array"
        },
        "scenarios": {
          "items": {
            "$ref": "#/$defs/ScenarioComparison"
          },
          "title": "Scenarios",
          "type": "array"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/ComparisonVerdict"
        }
      },
      "required": [
        "id",
        "created_at",
        "baseline_name",
        "baseline_hash",
        "candidate_hash",
        "compatibility",
        "compatibility_reasons",
        "config",
        "scenarios",
        "verdict",
        "reproduction_commands",
        "baseline_source",
        "candidate_source"
      ],
      "title": "ComparisonReport",
      "type": "object"
    },
    "ComparisonVerdict": {
      "additionalProperties": false,
      "description": "Pure gate result over comparison evidence.",
      "properties": {
        "new_critical": {
          "title": "New Critical",
          "type": "integer"
        },
        "new_high": {
          "title": "New High",
          "type": "integer"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "passed",
        "reasons",
        "warnings",
        "new_critical",
        "new_high"
      ],
      "title": "ComparisonVerdict",
      "type": "object"
    },
    "CompatibilityLevel": {
      "description": "Compatibility classification for two immutable suite artifacts.",
      "enum": [
        "compatible",
        "compatible_with_warning",
        "incompatible"
      ],
      "title": "CompatibilityLevel",
      "type": "string"
    },
    "ContextCompatibility": {
      "description": "Compatibility of two immutable evaluation contexts.",
      "enum": [
        "compatible",
        "incompatible"
      ],
      "title": "ContextCompatibility",
      "type": "string"
    },
    "ContextualSuiteManifest": {
      "additionalProperties": false,
      "description": "Context sidecar referencing an immutable completed SuiteRecord.",
      "properties": {
        "context": {
          "$ref": "#/$defs/EvaluationContext"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "suite_record_hash": {
          "title": "Suite Record Hash",
          "type": "string"
        }
      },
      "required": [
        "suite_record_hash",
        "context"
      ],
      "title": "ContextualSuiteManifest",
      "type": "object"
    },
    "DistributionSummary": {
      "additionalProperties": false,
      "description": "Small-sample-aware deterministic distribution summary.",
      "properties": {
        "completed": {
          "title": "Completed",
          "type": "integer"
        },
        "cost_minor_total": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Minor Total"
        },
        "duration_p50_ms": {
          "title": "Duration P50 Ms",
          "type": "number"
        },
        "duration_p95_ms": {
          "title": "Duration P95 Ms",
          "type": "number"
        },
        "errors": {
          "title": "Errors",
          "type": "integer"
        },
        "failed": {
          "title": "Failed",
          "type": "integer"
        },
        "infrastructure_error_rate": {
          "default": 0,
          "title": "Infrastructure Error Rate",
          "type": "number"
        },
        "low_sample": {
          "title": "Low Sample",
          "type": "boolean"
        },
        "mutation_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Mutation Counts",
          "type": "object"
        },
        "outcome_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Outcome Counts",
          "type": "object"
        },
        "pass_rate": {
          "title": "Pass Rate",
          "type": "number"
        },
        "passed": {
          "title": "Passed",
          "type": "integer"
        },
        "requested": {
          "title": "Requested",
          "type": "integer"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "severity_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Severity Counts",
          "type": "object"
        },
        "terminal_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Terminal Counts",
          "type": "object"
        },
        "tokens_total": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens Total"
        },
        "tool_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Tool Counts",
          "type": "object"
        },
        "variability": {
          "title": "Variability",
          "type": "number"
        },
        "wilson_high": {
          "title": "Wilson High",
          "type": "number"
        },
        "wilson_low": {
          "title": "Wilson Low",
          "type": "number"
        }
      },
      "required": [
        "requested",
        "completed",
        "passed",
        "failed",
        "errors",
        "pass_rate",
        "wilson_low",
        "wilson_high",
        "variability",
        "low_sample",
        "outcome_counts",
        "severity_counts",
        "terminal_counts",
        "tool_counts",
        "mutation_counts",
        "duration_p50_ms",
        "duration_p95_ms"
      ],
      "title": "DistributionSummary",
      "type": "object"
    },
    "EvaluationContext": {
      "additionalProperties": false,
      "description": "Server-derived business and runtime provenance for an evaluation.",
      "properties": {
        "agent_id": {
          "title": "Agent Id",
          "type": "string"
        },
        "agent_version": {
          "title": "Agent Version",
          "type": "string"
        },
        "catalog_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Catalog Version",
          "type": "string"
        },
        "domain_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
          "title": "Domain Id",
          "type": "string"
        },
        "limits": {
          "$ref": "#/$defs/Limits"
        },
        "role_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
          "title": "Role Id",
          "type": "string"
        },
        "scenario_hashes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Scenario Hashes",
          "type": "object"
        },
        "scenario_ids": {
          "items": {
            "type": "string"
          },
          "title": "Scenario Ids",
          "type": "array"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "seeds": {
          "items": {
            "type": "integer"
          },
          "title": "Seeds",
          "type": "array"
        },
        "suite_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suite Id"
        },
        "suite_revision": {
          "anyOf": [
            {
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suite Revision"
        },
        "world_name": {
          "title": "World Name",
          "type": "string"
        },
        "world_version": {
          "title": "World Version",
          "type": "string"
        }
      },
      "required": [
        "catalog_version",
        "domain_id",
        "role_id",
        "scenario_ids",
        "scenario_hashes",
        "agent_id",
        "agent_version",
        "world_name",
        "world_version",
        "seeds",
        "limits"
      ],
      "title": "EvaluationContext",
      "type": "object"
    },
    "EvidenceKind": {
      "description": "Kinds of bounded evidence references.",
      "enum": [
        "initial_snapshot",
        "final_snapshot",
        "event",
        "tool_call",
        "worker_turn",
        "authorization",
        "changed_entity",
        "resource",
        "policy"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "description": "Resolvable bounded reference into RunRecord evidence.",
      "properties": {
        "facts": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Facts",
          "type": "object"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "reference": {
          "title": "Reference",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sequence"
        },
        "value": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        }
      },
      "required": [
        "kind",
        "reference"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "FailureModeDelta": {
      "additionalProperties": false,
      "description": "Semantic failure change with representative evidence links.",
      "properties": {
        "baseline_rate": {
          "default": 0,
          "title": "Baseline Rate",
          "type": "number"
        },
        "baseline_run_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Baseline Run Ids",
          "type": "array"
        },
        "candidate_rate": {
          "default": 0,
          "title": "Candidate Rate",
          "type": "number"
        },
        "candidate_run_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Candidate Run Ids",
          "type": "array"
        },
        "change": {
          "title": "Change",
          "type": "string"
        },
        "event_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Event Ids",
          "type": "array"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "identity": {
          "title": "Identity",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "outcome_signatures": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Outcome Signatures",
          "type": "array"
        },
        "representative_evidence": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Representative Evidence",
          "type": "object"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "severity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity"
        },
        "verdict_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Verdict Ids",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "identity",
        "change"
      ],
      "title": "FailureModeDelta",
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "Limits": {
      "additionalProperties": false,
      "description": "Execution budgets for a scenario.",
      "properties": {
        "cost_minor": {
          "default": 0,
          "minimum": 0,
          "title": "Cost Minor",
          "type": "integer"
        },
        "injections": {
          "default": 20,
          "minimum": 0,
          "title": "Injections",
          "type": "integer"
        },
        "model_tokens": {
          "default": 12000,
          "minimum": 0,
          "title": "Model Tokens",
          "type": "integer"
        },
        "mutations": {
          "default": 20,
          "minimum": 0,
          "title": "Mutations",
          "type": "integer"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tool_calls": {
          "default": 20,
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        },
        "tool_timeout_s": {
          "default": 10,
          "exclusiveMinimum": 0,
          "title": "Tool Timeout S",
          "type": "number"
        },
        "wall_time_s": {
          "default": 30,
          "exclusiveMinimum": 0,
          "title": "Wall Time S",
          "type": "number"
        },
        "worker_turns": {
          "default": 50,
          "exclusiveMinimum": 0,
          "title": "Worker Turns",
          "type": "integer"
        }
      },
      "title": "Limits",
      "type": "object"
    },
    "RoleComparisonSummary": {
      "additionalProperties": false,
      "description": "Comparable role-level aggregates linked to immutable run IDs.",
      "properties": {
        "baseline": {
          "$ref": "#/$defs/RoleMetrics"
        },
        "candidate": {
          "$ref": "#/$defs/RoleMetrics"
        },
        "cost_delta_minor": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cost Delta Minor"
        },
        "duration_delta_ms": {
          "title": "Duration Delta Ms",
          "type": "integer"
        },
        "failure_delta": {
          "title": "Failure Delta",
          "type": "integer"
        },
        "model_token_delta": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model Token Delta"
        },
        "mutation_delta": {
          "title": "Mutation Delta",
          "type": "integer"
        },
        "pass_rate_delta": {
          "title": "Pass Rate Delta",
          "type": "number"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tool_call_delta": {
          "title": "Tool Call Delta",
          "type": "integer"
        }
      },
      "required": [
        "baseline",
        "candidate",
        "pass_rate_delta",
        "failure_delta",
        "tool_call_delta",
        "mutation_delta",
        "duration_delta_ms",
        "model_token_delta",
        "cost_delta_minor"
      ],
      "title": "RoleComparisonSummary",
      "type": "object"
    },
    "RoleMetrics": {
      "additionalProperties": false,
      "description": "Role-level outcome, behavior, resource, and evidence summary.",
      "properties": {
        "cost_minor": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cost Minor"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "failures": {
          "title": "Failures",
          "type": "integer"
        },
        "incomplete_evidence": {
          "title": "Incomplete Evidence",
          "type": "integer"
        },
        "model_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model Tokens"
        },
        "mutations": {
          "title": "Mutations",
          "type": "integer"
        },
        "pass_rate": {
          "title": "Pass Rate",
          "type": "number"
        },
        "passed": {
          "title": "Passed",
          "type": "integer"
        },
        "run_ids_by_scenario": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Run Ids By Scenario",
          "type": "object"
        },
        "runs": {
          "title": "Runs",
          "type": "integer"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tool_calls": {
          "title": "Tool Calls",
          "type": "integer"
        }
      },
      "required": [
        "runs",
        "passed",
        "pass_rate",

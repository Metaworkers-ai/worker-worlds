{
  "$defs": {
    "AuthorizationContext": {
      "additionalProperties": false,
      "description": "Trusted authority supplied by the harness, never world prose.",
      "properties": {
        "actor_id": {
          "title": "Actor Id",
          "type": "string"
        },
        "customer_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Customer Id"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scopes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Scopes",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "actor_id"
      ],
      "title": "AuthorizationContext",
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "ToolCall": {
      "additionalProperties": false,
      "description": "Normalized worker request to invoke a world tool.",
      "properties": {
        "arguments": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Arguments",
          "type": "object"
        },
        "authorization": {
          "$ref": "#/$defs/AuthorizationContext"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idempotency Key"
        },
        "requested_at": {
          "description": "Timezone-aware UTC timestamp",
          "format": "date-time",
          "title": "Requested At",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tool_name": {
          "title": "Tool Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "run_id",
        "tool_name",
        "arguments",
        "authorization",
        "requested_at"
      ],
      "title": "ToolCall",
      "type": "object"
    },
    "ToolResult": {
      "additionalProperties": false,
      "description": "Normalized result, including typed failure provenance.",
      "properties": {
        "audit_metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Audit Metadata",
          "type": "object"
        },
        "call_id": {
          "title": "Call Id",
          "type": "string"
        },
        "duration_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "ended_at": {
          "description": "Timezone-aware UTC timestamp",
          "format": "date-time",
          "title": "Ended At",
          "type": "string"
        },
        "error_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Message"
        },
        "error_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Type"
        },
        "output": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "retry_of": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry Of"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "started_at": {
          "description": "Timezone-aware UTC timestamp",
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ToolResultStatus"
        }
      },
      "required": [
        "call_id",
        "status",
        "started_at",
        "ended_at"
      ],
      "title": "ToolResult",
      "type": "object"
    },
    "ToolResultStatus": {
      "description": "Normalized tool result status.",
      "enum": [
        "success",
        "error"
      ],
      "title": "ToolResultStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One normalized worker decision and its observed result.",
  "properties": {
    "cost_minor": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost Minor"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "index": {
      "minimum": 0,
      "title": "Index",
      "type": "integer"
    },
    "message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Message"
    },
    "model_input_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Input Tokens"
    },
    "model_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Name"
    },
    "model_output_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Output Tokens"
    },
    "model_provider": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Provider"
    },
    "model_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Tokens"
    },
    "model_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Version"
    },
    "occurred_at": {
      "description": "Timezone-aware UTC timestamp",
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "provider_request_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Provider Request Ids",
      "type": "array"
    },
    "provider_response_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Provider Response Ids",
      "type": "array"
    },
    "provider_retry_count": {
      "default": 0,
      "minimum": 0,
      "title": "Provider Retry Count",
      "type": "integer"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "terminal": {
      "default": false,
      "title": "Terminal",
      "type": "boolean"
    },
    "tool_call": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolCall"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tool_result": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "index",
    "occurred_at"
  ],
  "title": "WorkerTurn",
  "type": "object"
}

{
  "additionalProperties": false,
  "description": "A deterministic enterprise world offered by Worker Worlds.",
  "properties": {
    "capability_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Capability Ids",
      "type": "array"
    },
    "description": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "label": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Label",
      "type": "string"
    },
    "role_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Role Ids",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Version",
      "type": "string"
    },
    "world_names": {
      "items": {
        "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
        "type": "string"
      },
      "title": "World Names",
      "type": "array"
    }
  },
  "required": [
    "id",
    "version",
    "label",
    "description",
    "world_names",
    "role_ids",
    "capability_ids"
  ],
  "title": "DomainDefinition",
  "type": "object"
}

{
  "additionalProperties": false,
  "description": "One independently versioned business capability.",
  "properties": {
    "description": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "domain_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
      "title": "Domain Id",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "label": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Label",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "domain_id",
    "version",
    "label",
    "description"
  ],
  "title": "CapabilityDefinition",
  "type": "object"
}

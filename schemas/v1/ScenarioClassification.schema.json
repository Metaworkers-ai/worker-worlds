{
  "$defs": {
    "Difficulty": {
      "description": "Bounded scenario difficulty.",
      "enum": [
        "basic",
        "intermediate",
        "advanced",
        "adversarial"
      ],
      "title": "Difficulty",
      "type": "string"
    },
    "RiskCategory": {
      "description": "Bounded enterprise risk category.",
      "enum": [
        "financial",
        "authorization",
        "operational",
        "safety",
        "reliability"
      ],
      "title": "RiskCategory",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "External taxonomy for one immutable scenario definition.",
  "properties": {
    "capability_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
      "title": "Capability Id",
      "type": "string"
    },
    "difficulty": {
      "$ref": "#/$defs/Difficulty"
    },
    "domain_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
      "title": "Domain Id",
      "type": "string"
    },
    "risk_category": {
      "$ref": "#/$defs/RiskCategory"
    },
    "role_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Role Ids",
      "type": "array"
    },
    "scenario_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Scenario Hash",
      "type": "string"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "scenario_id",
    "scenario_hash",
    "domain_id",
    "role_ids",
    "capability_id",
    "difficulty",
    "risk_category"
  ],
  "title": "ScenarioClassification",
  "type": "object"
}

{
  "$defs": {
    "JsonValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "SuiteJobStatus": {
      "description": "Legal persisted suite-job lifecycle states.",
      "enum": [
        "queued",
        "running",
        "cancelling",
        "cancelled",
        "completed",
        "failed"
      ],
      "title": "SuiteJobStatus",
      "type": "string"
    },
    "SuiteScenarioRecord": {
      "additionalProperties": false,
      "description": "Restart-safe progress for one suite scenario.",
      "properties": {
        "attempts": {
          "default": 0,
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "error_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Message"
        },
        "error_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Type"
        },
        "ordinal": {
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "run_record_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Record Hash"
        },
        "scenario_id": {
          "title": "Scenario Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/SuiteScenarioStatus"
        },
        "terminal_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Terminal Reason"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "scenario_id",
        "ordinal",
        "status",
        "updated_at"
      ],
      "title": "SuiteScenarioRecord",
      "type": "object"
    },
    "SuiteScenarioStatus": {
      "description": "Persisted state for one scenario inside a suite job.",
      "enum": [
        "pending",
        "running",
        "passed",
        "failed",
        "error",
        "cancelled"
      ],
      "title": "SuiteScenarioStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Durable mutable-job snapshot kept separate from final SuiteRecord.",
  "properties": {
    "agent_id": {
      "title": "Agent Id",
      "type": "string"
    },
    "cancel_requested": {
      "title": "Cancel Requested",
      "type": "boolean"
    },
    "catalog_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Catalog Version",
      "type": "string"
    },
    "completed_scenarios": {
      "minimum": 0,
      "title": "Completed Scenarios",
      "type": "integer"
    },
    "configuration": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Configuration",
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "domain_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
      "title": "Domain Id",
      "type": "string"
    },
    "ended_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ended At"
    },
    "error_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Message"
    },
    "error_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Type"
    },
    "executor_expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Executor Expires At"
    },
    "executor_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Executor Id"
    },
    "failed_scenarios": {
      "minimum": 0,
      "title": "Failed Scenarios",
      "type": "integer"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "passed_scenarios": {
      "minimum": 0,
      "title": "Passed Scenarios",
      "type": "integer"
    },
    "request_key": {
      "title": "Request Key",
      "type": "string"
    },
    "revision": {
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "role_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
      "title": "Role Id",
      "type": "string"
    },
    "scenarios": {
      "items": {
        "$ref": "#/$defs/SuiteScenarioRecord"
      },
      "title": "Scenarios",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "$ref": "#/$defs/SuiteJobStatus"
    },
    "suite_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
      "title": "Suite Id",
      "type": "string"
    },
    "suite_record_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Suite Record Path"
    },
    "suite_revision": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Suite Revision",
      "type": "string"
    },
    "total_scenarios": {
      "minimum": 0,
      "title": "Total Scenarios",
      "type": "integer"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "world": {
      "title": "World",
      "type": "string"
    }
  },
  "required": [
    "id",
    "request_key",
    "status",
    "catalog_version",
    "domain_id",
    "role_id",
    "suite_id",
    "suite_revision",
    "agent_id",
    "world",
    "configuration",
    "total_scenarios",
    "completed_scenarios",
    "passed_scenarios",
    "failed_scenarios",
    "cancel_requested",
    "revision",
    "scenarios",
    "created_at",
    "updated_at"
  ],
  "title": "SuiteJobRecord",
  "type": "object"
}

{
  "$defs": {
    "AgentAdapterType": {
      "description": "Framework boundaries supported by schema version one.",
      "enum": [
        "stub",
        "openai-agents",
        "langgraph"
      ],
      "title": "AgentAdapterType",
      "type": "string"
    },
    "AgentDefinition": {
      "additionalProperties": false,
      "description": "A selectable agent without credentials or imported SDK objects.",
      "properties": {
        "adapter": {
          "$ref": "#/$defs/AgentAdapterType"
        },
        "factory": {
          "anyOf": [
            {
              "pattern": "^(?P<module>[A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*):(?P<callable>[A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Factory"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentModelMetadata"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "required_env": {
          "default": [],
          "items": {
            "pattern": "^[A-Z_][A-Z0-9_]*$",
            "type": "string"
          },
          "title": "Required Env",
          "type": "array",
          "uniqueItems": true
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "supported_domain_ids": {
          "default": [
            "commerce",
            "insurance"
          ],
          "items": {
            "type": "string"
          },
          "title": "Supported Domain Ids",
          "type": "array"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:[-+][0-9A-Za-z.-]+)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "adapter"
      ],
      "title": "AgentDefinition",
      "type": "object"
    },
    "AgentModelMetadata": {
      "additionalProperties": false,
      "description": "Non-secret model identity used for reproducibility.",
      "properties": {
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*$",
          "title": "Name",
          "type": "string"
        },
        "provider": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Provider",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:[-+][0-9A-Za-z.-]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "provider",
        "name"
      ],
      "title": "AgentModelMetadata",
      "type": "object"
    },
    "ComparisonConfig": {
      "additionalProperties": false,
      "description": "Strict deterministic regression-gate configuration.",
      "properties": {
        "allow_scenario_hash_mismatch": {
          "default": false,
          "title": "Allow Scenario Hash Mismatch",
          "type": "boolean"
        },
        "critical_occurrences_allowed": {
          "default": 0,
          "minimum": 0,
          "title": "Critical Occurrences Allowed",
          "type": "integer"
        },
        "excluded_informational_metrics": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Excluded Informational Metrics",
          "type": "array"
        },
        "insufficient_samples": {
          "default": "warning",
          "pattern": "^(warning|fail)$",
          "title": "Insufficient Samples",
          "type": "string"
        },
        "maximum_cost_increase": {
          "default": 1.0,
          "minimum": 0,
          "title": "Maximum Cost Increase",
          "type": "number"
        },
        "maximum_flakiness_increase": {
          "default": 0.1,
          "minimum": 0,
          "title": "Maximum Flakiness Increase",
          "type": "number"
        },
        "maximum_infrastructure_error_rate": {
          "default": 0.01,
          "maximum": 1,
          "minimum": 0,
          "title": "Maximum Infrastructure Error Rate",
          "type": "number"
        },
        "maximum_p50_latency_increase": {
          "default": 1.0,
          "minimum": 0,
          "title": "Maximum P50 Latency Increase",
          "type": "number"
        },
        "maximum_p95_latency_increase": {
          "default": 1.0,
          "minimum": 0,
          "title": "Maximum P95 Latency Increase",
          "type": "number"
        },
        "maximum_pass_rate_decrease": {
          "default": 0.02,
          "maximum": 1,
          "minimum": 0,
          "title": "Maximum Pass Rate Decrease",
          "type": "number"
        },
        "maximum_token_increase": {
          "default": 1.0,
          "minimum": 0,
          "title": "Maximum Token Increase",
          "type": "number"
        },
        "minimum_candidate_pass_rate": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Candidate Pass Rate",
          "type": "number"
        },
        "new_high_failures_allowed": {
          "default": 0,
          "minimum": 0,
          "title": "New High Failures Allowed",
          "type": "integer"
        },
        "practical_significance": {
          "default": 0.02,
          "maximum": 1,
          "minimum": 0,
          "title": "Practical Significance",
          "type": "number"
        },
        "required_minimum_repetitions": {
          "default": 5,
          "exclusiveMinimum": 0,
          "title": "Required Minimum Repetitions",
          "type": "integer"
        },
        "scenario_overrides": {
          "additionalProperties": {
            "additionalProperties": {
              "$ref": "#/$defs/ComparisonOverrideValue"
            },
            "type": "object"
          },
          "title": "Scenario Overrides",
          "type": "object"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tag_overrides": {
          "additionalProperties": {
            "additionalProperties": {
              "$ref": "#/$defs/ComparisonOverrideValue"
            },
            "type": "object"
          },
          "title": "Tag Overrides",
          "type": "object"
        }
      },
      "title": "ComparisonConfig",
      "type": "object"
    },
    "ComparisonOverrideValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ]
    },
    "DatabaseConfig": {
      "additionalProperties": false,
      "description": "Database configuration without a persisted default credential.",
      "properties": {
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "title": "DatabaseConfig",
      "type": "object"
    },
    "ExecutionConfig": {
      "additionalProperties": false,
      "description": "Bounded suite execution settings.",
      "properties": {
        "concurrency": {
          "default": 4,
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Concurrency",
          "type": "integer"
        },
        "cost_minor": {
          "default": 0,
          "minimum": 0,
          "title": "Cost Minor",
          "type": "integer"
        },
        "model_tokens": {
          "default": 12000,
          "minimum": 0,
          "title": "Model Tokens",
          "type": "integer"
        },
        "mutations": {
          "default": 20,
          "maximum": 10000,
          "minimum": 0,
          "title": "Mutations",
          "type": "integer"
        },
        "repetitions": {
          "default": 1,
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Repetitions",
          "type": "integer"
        },
        "scenario_locations": {
          "default": [
            "examples/scenarios"
          ],
          "items": {
            "type": "string"
          },
          "title": "Scenario Locations",
          "type": "array"
        },
        "tool_calls": {
          "default": 20,
          "maximum": 10000,
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        },
        "wall_time_s": {
          "default": 30,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Wall Time S",
          "type": "number"
        },
        "worker": {
          "default": "stub",
          "title": "Worker",
          "type": "string"
        },
        "world": {
          "default": "stub",
          "enum": [
            "stub",
            "postgres",
            "supply-chain",
            "insurance"
          ],
          "title": "World",
          "type": "string"
        }
      },
      "title": "ExecutionConfig",
      "type": "object"
    },
    "ReportingConfig": {
      "additionalProperties": false,
      "description": "Portable artifact settings.",
      "properties": {
        "mode": {
          "default": "auto",
          "enum": [
            "auto",
            "full",
            "summary"
          ],
          "title": "Mode",
          "type": "string"
        },
        "output": {
          "default": ".worker-worlds/runs",
          "title": "Output",
          "type": "string"
        },
        "redact_keys": {
          "default": [
            "secret",
            "password",
            "api_key",
            "access_token"
          ],
          "items": {
            "type": "string"
          },
          "title": "Redact Keys",
          "type": "array"
        }
      },
      "title": "ReportingConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Versioned top-level project configuration.",
  "properties": {
    "agents": {
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$": {
          "$ref": "#/$defs/AgentDefinition"
        }
      },
      "title": "Agents",
      "type": "object"
    },
    "baselines_directory": {
      "default": ".worker-worlds/baselines",
      "title": "Baselines Directory",
      "type": "string"
    },
    "catalog_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Catalog Path"
    },
    "comparison": {
      "$ref": "#/$defs/ComparisonConfig"
    },
    "database": {
      "$ref": "#/$defs/DatabaseConfig"
    },
    "execution": {
      "$ref": "#/$defs/ExecutionConfig"
    },
    "provider": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Provider",
      "type": "object"
    },
    "reporting": {
      "$ref": "#/$defs/ReportingConfig"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "title": "WorkerWorldsConfig",
  "type": "object"
}

{
  "additionalProperties": false,
  "description": "Non-secret model identity used for reproducibility.",
  "properties": {
    "name": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*$",
      "title": "Name",
      "type": "string"
    },
    "provider": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Provider",
      "type": "string"
    },
    "version": {
      "anyOf": [
        {
          "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:[-+][0-9A-Za-z.-]+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Version"
    }
  },
  "required": [
    "provider",
    "name"
  ],
  "title": "AgentModelMetadata",
  "type": "object"
}
